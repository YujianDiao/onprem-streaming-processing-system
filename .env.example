# Environment Configuration for Data Platform
# Copy this file to .env and customize as needed

# ==========================================
# PostgreSQL Configuration (Hive Metastore)
# ==========================================
POSTGRES_USER=hive
POSTGRES_PASSWORD=hive123
POSTGRES_DB=metastore

# ==========================================
# MinIO Configuration
# ==========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_DOMAIN=minio

# ==========================================
# Kafka Configuration
# ==========================================
KAFKA_HEAP_OPTS=-Xmx1G -Xms1G
KAFKA_REPLICATION_FACTOR=2
KAFKA_MIN_INSYNC_REPLICAS=2

# ==========================================
# Spark Configuration
# ==========================================
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=4G
SPARK_WORKER_CORES=2
SPARK_DRIVER_MEMORY=1G
SPARK_EXECUTOR_MEMORY=2G

# ==========================================
# Trino Configuration
# ==========================================
TRINO_QUERY_MAX_MEMORY=2GB
TRINO_QUERY_MAX_MEMORY_PER_NODE=1GB

# ==========================================
# Data Generator Configuration
# ==========================================
DATA_GENERATOR_TOPIC=banking-transactions
DATA_GENERATOR_INTERVAL_MS=1000

# ==========================================
# DataHub Configuration (Optional)
# ==========================================
DATAHUB_DB_NAME=datahub
DATAHUB_DB_USER=datahub
DATAHUB_DB_PASSWORD=datahub

# ==========================================
# Monitoring Configuration
# ==========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ==========================================
# General Configuration
# ==========================================
COMPOSE_PROJECT_NAME=data-platform
DOCKER_NETWORK=data-platform
TZ=UTC
