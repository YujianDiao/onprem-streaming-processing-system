# Environment Configuration for Data Platform
# Copy this file to .env and customize as needed

# ==========================================
# PostgreSQL Configuration
# ==========================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=metastore

# ==========================================
# MinIO Configuration
# ==========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_DOMAIN=minio

# ==========================================
# Kafka Configuration
# ==========================================
KAFKA_HEAP_OPTS=-Xmx1G -Xms1G
KAFKA_REPLICATION_FACTOR=2
KAFKA_MIN_INSYNC_REPLICAS=2

# ==========================================
# Spark Configuration
# ==========================================
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=4G
SPARK_WORKER_CORES=2
SPARK_DRIVER_MEMORY=1G
SPARK_EXECUTOR_MEMORY=2G

# ==========================================
# Airflow Configuration
# ==========================================
AIRFLOW_FERNET_KEY=UKMzEm3yIuFYEq1y3-2FxPNWSVwRASpahmQ9kQfEr8E=
AIRFLOW_SECRET_KEY=secret
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_EXECUTOR=LocalExecutor

# ==========================================
# Superset Configuration
# ==========================================
SUPERSET_SECRET_KEY=thisISaSECRET_1234
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin

# ==========================================
# DataHub Configuration (Optional)
# ==========================================
DATAHUB_DB_NAME=datahub
DATAHUB_DB_USER=datahub
DATAHUB_DB_PASSWORD=datahub

# ==========================================
# Monitoring Configuration
# ==========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ==========================================
# General Configuration
# ==========================================
COMPOSE_PROJECT_NAME=data-platform
DOCKER_NETWORK=data-platform
TZ=UTC
